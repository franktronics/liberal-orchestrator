{
  "name": "lior",
  "version": "0.1.0",
  "description": "Explicitly configure which AI models play which roles in agent coding harnesses (Codex, OpenCode)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franktronics/liberal-orchestrator.git"
  },
  "homepage": "https://github.com/franktronics/liberal-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/franktronics/liberal-orchestrator/issues"
  },
  "keywords": ["codex", "opencode", "ai", "agents", "orchestration", "model-routing"],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "lior": "dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "lior": "bun src/cli/index.ts",
    "build": "bun build src/cli/index.ts --target=node --outfile=dist/cli.js",
    "package:check": "bun scripts/package-smoke.ts",
    "prepack": "bun run build",
    "test": "bun test",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "update-registry": "bun scripts/update-registry.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.9",
    "citty": "^0.1.6",
    "picocolors": "^1.1.1",
    "typescript": "^5.6.2",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  }
}
